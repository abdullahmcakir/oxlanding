# Sitenin yayındaki adresi (canonical, sitemap, paylaşım görselleri)
NEXT_PUBLIC_SITE_URL=https://oxdijital.com

# OX Panel adresi: "Ücretsiz görüşme" butonları panelin /yeni-talep hunisine gider (ör. https://panel.ox-software.com)
NEXT_PUBLIC_PANEL_URL=
# Rybbit (kendi sunucumuzda): ölçüm olayları /api/olcum üzerinden iletilir. Yalnız sunucuda; Dokploy Environment
RYBBIT_URL=https://olcum.ox-software.com
RYBBIT_SITE_ID=97cb37bdb613
RYBBIT_API_KEY=

# OX Panel ölçüm alma adresi ve anahtarı (yalnız sunucuda; tarayıcıya inmez)
OX_PANEL_OLCUM_URL=
OX_PANEL_OLCUM_KEY=

# WhatsApp numarası, ülke koduyla, boşluksuz (ör. 905001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Reklam ve analiz etiketleri: yalnız çerez onayından sonra yüklenir; boş bırakılan yüklenmez
NEXT_PUBLIC_META_PIXEL_ID=2828018587592498
NEXT_PUBLIC_GA4_ID=G-NN8T72PK7L
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads'te "görüşme butonuna tıklama" dönüşümünün etiketi (AW-.../BURASI)
NEXT_PUBLIC_GOOGLE_ADS_TALEP_LABEL=

# Asistandaki hız testi için PageSpeed API anahtarı (isteğe bağlı; yoksa kota çabuk dolar)
NEXT_PUBLIC_PAGESPEED_KEY=
